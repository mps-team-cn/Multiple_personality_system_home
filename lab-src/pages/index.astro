---
const title = 'MPSTEAM Lab';
const description = 'MPS Team CN 的实验项目、互动页面与小游戏入口。';
const currentYear = new Date().getFullYear();
const mainSite = 'https://mpsteam.cn';
const labSite = 'https://lab.mpsteam.cn';

const navItems = [
  { text: '主页', href: `${mainSite}/` },
  { text: '关于我们', href: `${mainSite}/about` },
  { text: '加入社区', href: `${mainSite}/join` },
  { text: 'Wiki', href: 'https://wiki.mpsteam.cn/', external: true },
  { text: 'Lab', href: `${labSite}/`, active: true },
  { text: 'GitHub', href: 'https://github.com/mps-team-cn', external: true },
  { text: '友情链接', href: `${mainSite}/links` },
  { text: '联系我们', href: `${mainSite}/contact` },
];

const projects = [
  {
    title: '横线赛车经营赛',
    eyebrow: 'Line Racing Manager',
    description: '复古 Windows 风格赛车经营小游戏。报名、起步、改装，在横线赛道里攒出更好的车。',
    href: 'race/',
    status: '主推 v1.8.1',
    accent: 'race',
    cta: '开始比赛',
    image: '/img/race-cover.png',
    imageAlt: '横线赛车经营赛截图',
    meta: ['经营', '改装', '成就'],
  },
  {
    title: '后院投掷赛',
    eyebrow: 'Backyard Throw Battle',
    description: '回合制投掷小游戏。调角度、按住蓄力，再用一次性道具和风向改变弹道。',
    href: 'throw-battle/',
    status: '实验 v0.2',
    accent: 'throw',
    cta: '进入实验',
    image: '/img/throw-battle-cover.png',
    imageAlt: '后院投掷赛截图',
    meta: ['单人 / 双人', '角度瞄准', '道具'],
  },
  {
    title: '小旅猫',
    eyebrow: 'Little Travel Cat',
    description: '低压力放置旅行小游戏。收集露珠，准备行李，等猫带回明信片和纪念品。',
    href: 'little-travel-cat/',
    status: '实验 v0.1',
    accent: 'cat',
    cta: '进入实验',
    image: '/img/little-travel-cat-cover.png',
    imageAlt: '小旅猫截图',
    meta: ['放置', '本地存档', '慢节奏'],
  },
  {
    title: '指尖机械转盘',
    eyebrow: 'Fidget Wheel',
    description: '模拟金属 EDC 转盘的网页解压玩具。拨一下、听着刻度咔哒声转动，再看看最后停在哪个数字。',
    href: 'fidget-wheel/',
    status: '实验 v0.1',
    accent: 'fidget',
    cta: '拨一下',
    image: '/img/fidget-wheel-cover.jpg',
    imageAlt: '指尖机械转盘金属轮盘封面',
    meta: ['解压', '机械手感', '随机决策'],
  },
];

const featuredProject = projects[0];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`${labSite}/`} />
    <meta name="theme-color" content="#2f9b73" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${labSite}/`} />
    <meta property="og:title" content={`${title} - 实验项目入口`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="MPS Team CN" />
    <link rel="icon" type="image/png" href={`${mainSite}/favicon.png`} />
    <title>{title} - 实验项目入口</title>
  </head>
  <body>
    <a class="skip-link" href="#projects">跳到项目列表</a>

    <nav class="site-nav" aria-label="主导航">
      <div class="nav-inner">
        <a class="brand" href={`${mainSite}/`}>MPS Team CN</a>
        <div class="nav-links" aria-label="站点导航">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={item.active ? 'active' : undefined}
                aria-current={item.active ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.text}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <main>
      <section class="intro" aria-labelledby="lab-title">
        <div class="intro-copy">
          <p class="overline">MPS Team CN / Lab</p>
          <h1 id="lab-title">MPSTEAM Lab</h1>
          <p class="lead">主推项目是横线赛车经营赛；其他互动页面和小游戏仍按实验项目整理在下方。</p>
          <div class="intro-actions" aria-label="主要操作">
            <a class="button primary" href={featuredProject.href}>{featuredProject.cta}</a>
            <a class="button secondary" href="#projects">查看全部项目</a>
          </div>
        </div>

        <aside class="feature-panel" aria-label="当前重点项目">
          <div class="feature-heading">
            <span>主推项目</span>
            <strong>{featuredProject.status}</strong>
          </div>
          <div class={`project-media ${featuredProject.accent}`}>
            <img
              src={featuredProject.image}
              alt={featuredProject.imageAlt}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          <p class="card-eyebrow">{featuredProject.eyebrow}</p>
          <h2>{featuredProject.title}</h2>
          <p>{featuredProject.description}</p>
          <div class="meta-list" aria-label="项目标签">
            {featuredProject.meta.map((item) => <span>{item}</span>)}
          </div>
        </aside>
      </section>

      <section id="projects" class="project-section" aria-labelledby="projects-title">
        <div class="section-inner">
          <div class="section-heading">
            <p class="section-label">Projects</p>
            <h2 id="projects-title">全部项目</h2>
            <p>Race 保持为主要入口，其它页面按实验状态标注。</p>
          </div>

          <div class="project-grid">
            {
              projects.map((project) => (
                <article class={`project-card ${project.accent}`}>
                  <div class="card-status">
                    <span>{project.status}</span>
                  </div>
                  <div class={`project-media ${project.accent}`}>
                    <img
                      src={project.image}
                      alt={project.imageAlt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <p class="card-eyebrow">{project.eyebrow}</p>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <div class="meta-list" aria-label="项目标签">
                    {project.meta.map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                  <a class="card-link" href={project.href}>
                    <span>{project.cta}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <div class="footer-brand">MPS Team CN</div>
          <p>多意识体科普与社区</p>
        </div>
        <div>
          <h2>主站</h2>
          <ul>
            <li><a href={`${mainSite}/about`}>关于我们</a></li>
            <li><a href={`${mainSite}/join`}>加入社区</a></li>
            <li><a href={`${mainSite}/links`}>友情链接</a></li>
          </ul>
        </div>
        <div>
          <h2>联系</h2>
          <ul>
            <li><a href="mailto:contact@mpsteam.cn">contact@mpsteam.cn</a></li>
            <li><a href="mailto:support@mpsteam.cn">support@mpsteam.cn</a></li>
          </ul>
        </div>
      </div>
      <div class="copyright">© {currentYear} MPS Team CN. 保留所有权利。</div>
    </footer>
  </body>
</html>

<style>
  :root {
    --brand: #2f9b73;
    --brand-strong: #217a5a;
    --ink: #111827;
    --muted: #64748b;
    --bg: #fbfcfb;
    --surface: #f2f6f3;
    --panel: #ffffff;
    --border: #dbe5dd;
    --shadow: 0 18px 45px rgba(23, 43, 34, 0.1);
    --throw: #e7773d;
    --cat: #2c8fb8;
    --race: #6f66d8;
    --radius: 8px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --brand: #54c595;
      --brand-strong: #83d9b2;
      --ink: #ecf4ef;
      --muted: #a7b8ad;
      --bg: #101410;
      --surface: #171d18;
      --panel: #1d241e;
      --border: #2c392f;
      --shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    scroll-behavior: smooth;
    background: var(--bg);
    color: var(--ink);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background: var(--bg);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  .skip-link {
    position: fixed;
    left: 16px;
    top: 16px;
    z-index: 20;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bg);
    font-size: 14px;
    font-weight: 700;
    padding: 10px 14px;
    transform: translateY(-140%);
    transition: transform 0.2s ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .nav-inner {
    display: flex;
    width: min(100% - 40px, 1180px);
    min-height: 64px;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: var(--brand);
    font-size: 19px;
    font-weight: 800;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-links a {
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 14px;
    font-weight: 650;
    line-height: 1;
    padding: 10px 12px;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links .active {
    background: var(--surface);
    color: var(--brand-strong);
  }

  .intro {
    display: grid;
    width: min(100% - 48px, 1180px);
    margin: 0 auto;
    align-items: center;
    gap: 56px;
    grid-template-columns: minmax(0, 1fr) minmax(330px, 420px);
    padding: 72px 0 64px;
  }

  .intro-copy {
    max-width: 720px;
  }

  .overline,
  .section-label,
  .card-eyebrow {
    color: var(--brand-strong);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .overline {
    margin-bottom: 16px;
  }

  h1 {
    margin-bottom: 22px;
    font-size: clamp(44px, 8vw, 76px);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .lead {
    max-width: 620px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.8;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button,
  .card-link {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    border: 1px solid transparent;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.1;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .button {
    padding: 0 22px;
  }

  .button:hover,
  .card-link:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    background: var(--brand);
    color: #ffffff;
  }

  .button.primary:hover {
    background: var(--brand-strong);
  }

  .button.secondary {
    border-color: var(--border);
    background: var(--panel);
    color: var(--ink);
  }

  .button.secondary:hover {
    border-color: color-mix(in srgb, var(--brand) 55%, var(--border));
    color: var(--brand-strong);
  }

  .feature-panel,
  .project-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow);
  }

  .feature-panel {
    padding: 22px;
  }

  .feature-heading,
  .card-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }

  .feature-heading strong,
  .card-status span {
    border-radius: 999px;
    background: color-mix(in srgb, var(--brand) 12%, transparent);
    color: var(--brand-strong);
    padding: 7px 10px;
  }

  .project-media {
    height: 132px;
    margin-bottom: 20px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .feature-panel .project-media {
    height: 188px;
  }

  .project-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-eyebrow {
    margin-bottom: 8px;
  }

  .feature-panel h2,
  .project-card h3 {
    margin-bottom: 12px;
    color: var(--ink);
    letter-spacing: 0;
    line-height: 1.25;
  }

  .feature-panel h2 {
    font-size: 28px;
  }

  .project-card h3 {
    font-size: 22px;
  }

  .feature-panel p,
  .project-card p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .feature-panel p {
    margin-bottom: 18px;
  }

  .project-card p {
    margin-bottom: 18px;
  }

  .meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .meta-list span {
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    padding: 8px 10px;
  }

  .project-section {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 58px 0 72px;
  }

  .section-inner {
    width: min(100% - 48px, 1180px);
    margin: 0 auto;
  }

  .section-heading {
    display: grid;
    max-width: 720px;
    gap: 10px;
    margin-bottom: 26px;
  }

  .section-label,
  .section-heading h2,
  .section-heading p {
    margin-bottom: 0;
  }

  .section-heading h2 {
    font-size: 32px;
    line-height: 1.2;
  }

  .section-heading p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .project-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 20px;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--brand) 45%, var(--border));
    box-shadow: 0 22px 55px rgba(23, 43, 34, 0.13);
    transform: translateY(-3px);
  }

  .card-link {
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin-top: auto;
    border-color: var(--border);
    color: var(--ink);
    padding: 0 14px;
  }

  .card-link:hover {
    border-color: color-mix(in srgb, var(--brand) 55%, var(--border));
    color: var(--brand-strong);
  }

  .project-card .meta-list {
    margin-bottom: 22px;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg);
    padding: 42px 0 28px;
  }

  .footer-inner {
    display: grid;
    width: min(100% - 48px, 1180px);
    margin: 0 auto;
    gap: 30px;
    grid-template-columns: 1.5fr 1fr 1fr;
  }

  .footer-brand {
    margin-bottom: 12px;
    color: var(--brand);
    font-size: 19px;
    font-weight: 800;
  }

  .site-footer p,
  .site-footer a {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .site-footer h2 {
    margin-bottom: 14px;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.2;
  }

  .site-footer ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a:hover {
    color: var(--brand-strong);
    text-decoration: underline;
  }

  .copyright {
    width: min(100% - 48px, 1180px);
    margin: 30px auto 0;
    border-top: 1px solid var(--border);
    padding-top: 24px;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 980px) {
    .nav-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      padding: 14px 0;
    }

    .nav-links {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 2px;
    }

    .intro {
      grid-template-columns: 1fr;
      padding-top: 56px;
    }

    .feature-panel {
      max-width: 560px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .footer-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .intro,
    .section-inner,
    .footer-inner,
    .copyright,
    .nav-inner {
      width: min(100% - 32px, 1180px);
    }

    h1 {
      font-size: 42px;
    }

    .lead {
      font-size: 17px;
    }

    .intro-actions {
      display: grid;
    }

    .button {
      width: 100%;
    }

    .feature-panel {
      padding: 16px;
    }

    .feature-panel .project-media {
      height: 150px;
    }

    .project-section {
      padding: 46px 0 56px;
    }
  }
</style>
